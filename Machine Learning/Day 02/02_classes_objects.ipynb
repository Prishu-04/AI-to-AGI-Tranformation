    "class Student:\n",
    "    def __init__(self, name, marks):\n",
    "        self.name = name\n",
    "        self.marks = marks\n",
    "\n",
    "\n",
    "student1 = Student(\"Rahul\", 85)\n",
    "student2 = Student(\"Priya\", 92)\n",
    "\n",
    "print(student1.name)\n",
    "print(student2.name)"
